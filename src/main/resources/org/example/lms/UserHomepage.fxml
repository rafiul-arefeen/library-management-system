            </font>
        </Label>
        <Label layoutX="50.0" layoutY="120.0" text="Here, you can:" wrapText="true" textFill="#616161">
            <font>
                <Font size="20.0" />
            </font>
        </Label>
        <Label layoutX="70.0" layoutY="160.0" text="- Request books to issue" textFill="#424242">
            <font>
                <Font size="18.0" />
            </font>
        </Label>
        <Label layoutX="70.0" layoutY="200.0" text="- Request to return issued books" textFill="#424242">

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="768.0" prefWidth="1280.0" stylesheets="@modern-button.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.lms.AdminDashboardController">
    <children>
        <AnchorPane fx:id="sidebar" prefHeight="768.0" prefWidth="280.0" style="-fx-background-color: lightgrey;">
            <children>
                <Button fx:id="btnHomepage" layoutX="25.0" layoutY="207.0" onAction="#onSidebarOptionClick" prefHeight="51.0" prefWidth="229.0" style="-fx-background-color: grey;" stylesheets="@modern-button.css" text="Dashboard">
                    <font>
                        <Font name="Helvetica Neue Condensed Black" size="20.0" />
                    </font>
                </Button>
                <Button fx:id="btnIssueBook" layoutX="25.0" layoutY="423.0" onAction="#onSidebarOptionClick" prefHeight="51.0" prefWidth="229.0" style="-fx-background-color: skyblue;" stylesheets="@modern-button.css" text="Issue Book">
                    <font>
                        <Font name="Helvetica Neue Condensed Black" size="20.0" />
                    </font>
                </Button>
                <Button fx:id="btnManageBooks" layoutX="26.0" layoutY="359.0" onAction="#onSidebarOptionClick" prefHeight="51.0" prefWidth="229.0" style="-fx-background-color: white;" stylesheets="@modern-button.css" text="Manage Books">
                    <font>
                        <Font name="Helvetica Neue Condensed Black" size="20.0" />
                    </font>
                </Button>
                <Button fx:id="btnReturnBook" layoutX="25.0" layoutY="548.0" onAction="#onSidebarOptionClick" prefHeight="51.0" prefWidth="229.0" style="-fx-background-color: orange;" stylesheets="@modern-button.css" text="Return Requests">
                    <font>
                        <Font name="Helvetica Neue Condensed Black" size="20.0" />
                    </font>
                </Button>
                <Button fx:id="btnViewRequests" layoutX="25.0" layoutY="485.0" onAction="#onSidebarOptionClick" prefHeight="51.0" prefWidth="229.0" style="-fx-background-color: lightgreen;" stylesheets="@modern-button.css" text="Issue Requests">
                    <font>
                        <Font name="Helvetica Neue Condensed Black" size="20.0" />
                    </font>
                </Button>
                <Button fx:id="btnManageMembers" layoutX="26.0" layoutY="295.0" onAction="#onSidebarOptionClick" prefHeight="51.0" prefWidth="229.0" style="-fx-background-color: white;" stylesheets="@modern-button.css" text="Manage Members">
                    <font>
                        <Font name="Helvetica Neue Condensed Black" size="20.0" />
                    </font>
                </Button>
                <Button fx:id="btnLogout" layoutX="26.0" layoutY="650.0" onAction="#onSidebarOptionClick" prefHeight="51.0" prefWidth="229.0" style="-fx-background-color: grey;" stylesheets="@modern-button.css" text="Logout">
                    <font>
                        <Font name="Helvetica Neue Condensed Black" size="20.0" />
                    </font>
                </Button>
                <ImageView fitHeight="76.0" fitWidth="92.0" layoutX="95.0" layoutY="46.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@../../../logo/logo.png" />
                    </image>
                </ImageView>
                <Label alignment="CENTER" layoutX="29.0" layoutY="122.0" prefHeight="51.0" prefWidth="222.0" text="LibraTrack">
                    <font>
                        <Font name="Carelia Upright" size="40.0" />
                    </font>
                </Label>
            </children>
        </AnchorPane>

        <!-- Main Content Area -->
        <AnchorPane fx:id="contentArea" layoutX="280.0" prefHeight="768.0" prefWidth="1000.0" />
    </children>
</AnchorPane>
